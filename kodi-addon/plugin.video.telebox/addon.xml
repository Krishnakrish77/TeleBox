<addon id="plugin.video.telebox" version="0.1.0" name="TeleBox" provider-name="SK Soft Solutions">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/router.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Stream from Telegram Channels and Groups</summary>
        <description>TeleBox lets you stream from your Telegram channels and groups directly in Kodi.</description>
        <platform>all</platform>
        <icon>icon.png</icon>
        <fanart>fanart.png</fanart>
        <language>en</language>
    </extension>
</addon>
